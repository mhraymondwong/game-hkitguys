config_version=5

[application]

config/name="香港IT人"
config/description="香港 IT 職涯模擬人生：開局＋月迴圈＋季節／事件＋公司模擬＋升遷跳槽＋勞動市場／裁員＋氛圍背景（Phase 3b／5.x）"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.07, 0.12, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
